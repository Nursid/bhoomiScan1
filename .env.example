# ---------------------------------------------------------------------------
# BhoomiScan Land Verification API - environment
# Copy to .env. Never commit real values. Every secret below is backend-only.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma separated list of allowed browser origins. Empty = no browser origins
# (mobile apps and server-to-server calls do not send Origin and are unaffected).
CORS_ORIGINS=
# Set when running behind a load balancer / reverse proxy (for correct client IPs).
TRUST_PROXY=false
# Serve Swagger UI at /api/docs
API_DOCS_ENABLED=true

# --- PostgreSQL (primary datastore) ----------------------------------------
DATABASE_URL=postgresql://bhoomiscan:bhoomiscan@localhost:5436/bhoomiscan?schema=public

# --- Redis (optional: metadata cache). Leave empty to use in-memory cache. --
REDIS_URL=
METADATA_CACHE_TTL_SECONDS=86400

# --- JWT --------------------------------------------------------------------
JWT_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=bhoomiscan-api

# --- Mobile OTP login (MSG91 OTP Widget) for POST /api/auth/mobile-verify ---
# The UI runs the widget's sendOtp(); the backend verifies the OTP with MSG91's
# widget verifyOtp API. No OTP is generated, stored or compared on the backend.
MSG91_WIDGET_ID=your_msg91_widget_id
MSG91_TOKEN_AUTH=your_msg91_widget_token_auth
# Optional fallback credential (account auth key) used only when MSG91_TOKEN_AUTH is empty.
MSG91_AUTH_KEY=
MSG91_BASE_URL=https://control.msg91.com
MSG91_TIMEOUT_MS=15000
# Development aid: log the (credential-redacted) verifyOtp response shape.
MSG91_DEBUG_VERIFY_RESPONSE=false
# Country code applied to bare 10-digit numbers
MOBILE_DEFAULT_COUNTRY_CODE=91

# --- Razorpay (Orders API) --------------------------------------------------
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Secret configured on the dashboard webhook (URL: /api/v1/payments/webhook)
# events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_MS=20000

# --- Surepass ---------------------------------------------------------------
# One client and one token serve every state (Punjab, Maharashtra, Bihar).
# Production: https://kyc-api.surepass.app. The token stays server-side only.
SUREPASS_BASE_URL=https://sandbox.surepass.io
SUREPASS_TOKEN=
# SUREPASS_API_TOKEN is accepted as an alias for SUREPASS_TOKEN.
SUREPASS_TIMEOUT_MS=30000
# Retries for read-only metadata lists (network errors / 429 / 5xx).
SUREPASS_METADATA_RETRIES=2
# Retries for the (billable) land verification call. Keep 0 unless Surepass
# confirms the call is idempotent for your account.
SUREPASS_VERIFY_RETRIES=0

# --- Land record diff -------------------------------------------------------
# Extra field names (any depth) or dotted paths to ignore when comparing.
# Added to the built-in defaults: client_id, request_id, timestamp, created_at,
# updated_at, transaction_id ...
LAND_DIFF_IGNORED_FIELDS=
# Set to false to compare ONLY your configured list (no built-in defaults).
LAND_DIFF_USE_DEFAULT_IGNORES=true

# --- Smart contract anchoring ----------------------------------------------
# http     = external Smart Contract REST API (SMART_CONTRACT_API_*)
# bsc      = direct BNB Smart Chain LandVerification contract via ethers
# disabled = records are marked SKIPPED
SMART_CONTRACT_PROVIDER=disabled
SMART_CONTRACT_API_URL=
SMART_CONTRACT_API_KEY=
SMART_CONTRACT_STORE_PATH=/records
SMART_CONTRACT_TIMEOUT_MS=30000
SMART_CONTRACT_MAX_ATTEMPTS=8
# Try the first submission inline (response includes the result); failures are
# always retried in the background either way.
SMART_CONTRACT_INLINE_SUBMIT=true
# bsc provider
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_CHAIN_ID=97
BSC_EXPLORER_TX_URL=https://testnet.bscscan.com/tx/
LAND_VERIFICATION_CONTRACT_ADDRESS=
OPERATOR_PRIVATE_KEY=

# --- Background jobs --------------------------------------------------------
# Run jobs inside the API process. Set false and run `npm run worker` separately
# when you scale the API horizontally (jobs are multi-instance safe either way).
JOBS_ENABLED=true
JOB_RECURRING_VERIFICATION_INTERVAL_SECONDS=300
JOB_SMART_CONTRACT_RETRY_INTERVAL_SECONDS=60
JOB_SUBSCRIPTION_EXPIRY_INTERVAL_SECONDS=300
JOB_BATCH_SIZE=20

# --- Rate limits (per window) ----------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_LAND_VERIFY_MAX=20
